[Unit]
Description=Refresh ARA AllMode public digital directories
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/allmode/directory_sync.py
TimeoutStartSec=300
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/allmode/directories /opt/allmode-dmr/hosts
